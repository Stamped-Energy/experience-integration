{
  "name": "stamped-l6",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "bash ./scripts/validate.sh",
    "ci:local": "bash ./scripts/ci-local.sh",
    "contracts:check": "./external/scripts/contracts/contract-check.sh",
    "contracts:upstream": "node ./scripts/check-upstream-contracts.mjs",
    "test:integration": "pnpm --filter @stamped/l6-api --filter @stamped/l6-worker --filter @stamped/l6-infra test",
    "smoke:bff": "pnpm --filter @stamped/l6-api exec tsx ../../scripts/smoke-bff.ts",
    "compose:smoke": "bash ./scripts/compose-smoke.sh",
    "seed:vinayak": "tsx packages/api/scripts/seed_vinayak_plant.ts"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@^3": "3.1.5",
      "fast-uri@^4": "4.1.2",
      "nanoid@^3": "3.3.18",
      "postcss@^8": "8.5.18",
      "deepmerge-ts": "8.0.0",
      "find-my-way": "9.7.0",
      "effect": "3.20.0",
      "@playwright/test": "1.55.1",
      "playwright": "1.55.1",
      "playwright-core": "1.55.1",
      "sharp": "0.35.0"
    }
  }
}
