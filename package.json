{
  "name": "stamped-l6",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "bash ./scripts/validate.sh",
    "ci:local": "bash ./scripts/ci-local.sh",
    "contracts:check": "./external/scripts/contracts/contract-check.sh",
    "contracts:upstream": "pnpm exec tsx ./scripts/check-upstream-contracts.ts",
    "test:integration": "pnpm --filter @stamped/l6-api --filter @stamped/l6-worker --filter @stamped/l6-infra test",
    "smoke:bff": "pnpm --filter @stamped/l6-api exec tsx ../../scripts/smoke-bff.ts",
    "compose:smoke": "bash ./scripts/compose-smoke.sh",
    "seed:vinayak": "tsx packages/api/scripts/seed_vinayak_plant.ts",
    "stamped-l6": "pnpm --filter @stamped/l6-agent-cli exec tsx ./bin/stamped-l6.ts"
  }
}
