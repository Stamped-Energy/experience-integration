{
  "name": "stamped-l6-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Stamped product UI on a fictional demonstration plant with illustrative data. No API or database required.",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit && node scripts/check-copy.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
