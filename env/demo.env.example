# Demo environment profile — Phase E / G
# Copy values into repo-root `.env` (never commit secrets).
# Reproduce CNC demo: LNM plant selectable, L2 live BFF, signed-in seed user.

NODE_ENV=development
USE_FIXTURES=false

# Auth — set explicitly (Phase S: no inventable defaults)
# BETTER_AUTH_SECRET=< >=32 chars >
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# L2 live path (Phase E)
L2_BASE_URL=http://127.0.0.1:8091
L2_TIMEOUT_MS=5000
L2_LIVE=true
# L2_SERVICE_KEY=<required for /api/l2/*>
L2_FEATURE_LEDGER=false
L2_FEATURE_BASELINES=false

# L5 / L4 gates for demo stack
L5_LIVE=true
L6_L5_LIVE=true
L4_LIVE=false

# Seed persona (pnpm --filter @stamped/l6-api seed:lnm-demo)
# DEMO_USER_EMAIL=
# DEMO_USER_PASSWORD=
# DEMO_USER_NAME=LNM Demo

# Plant identity (must match Phase B L2 seed)
# external plant_id = plant_lnm_faridabad_1
# org = org_acme / slug acme
# persona = lnm-factory-1

NEXT_PUBLIC_BFF_URL=http://localhost:3001
