# Phase H0 lean — Vercel fixture backup (no AWS, no BFF)
# Map these into the Vercel project Environment Variables UI.

USE_FIXTURES=true
NEXT_PUBLIC_ANALYST_LIVE=false

# Leave NEXT_PUBLIC_BFF_URL unset so the web app stays fixture-first.
# NEXT_PUBLIC_BFF_URL=

# Never set live upstream secrets on the lean backup project:
# L2_BASE_URL=
# L2_SERVICE_KEY=
# L5_BASE_URL=
# BETTER_AUTH_SECRET=
